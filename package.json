{
  "name": "fe-interview-design-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build-storybook": "storybook build",
    "dev": "vite",
    "check": "pnpm check:biome && pnpm lint:styles",
    "check:fix": "biome check . --write && pnpm lint:styles --fix",
    "check:biome": "biome check . --no-errors-on-unmatched",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "tsc": "tsc -b",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@stylistic/stylelint-config": "^5.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "sass": "^1.105.0",
    "storybook": "^10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
